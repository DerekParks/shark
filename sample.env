# Copy to .env next to docker-compose.yaml. Everything but the passwords is optional.

# Keep these URL-safe: the source password is embedded in the recorder's icecast:// URL.
ICECAST_SOURCE_PASSWORD=change-me
ICECAST_RELAY_PASSWORD=change-me
ICECAST_ADMIN_PASSWORD=change-me

# Starts the recorder too; it needs the RadioSHARK plugged in.
COMPOSE_PROFILES=recorder

# Time zone for recording file names and episode dates.
TZ=UTC

# Feed and dashboard.
# SHARK_FEED_TITLE=Shark Sports
# SHARK_FEED_DESCRIPTION=Games recorded off the radio by a Griffin RadioSHARK.
# SHARK_FEED_AUTHOR=Shark
# SHARK_COVER=/config/cover.jpg
# SHARK_WEB_PORT=8771

# Recording. Bitrates are kbps: SHARK_BITRATE for the saved MP3, SHARK_STREAM_BITRATE for the live stream.
# SHARK_ALSA_DEVICE=hw:CARD=RadioSHARK,DEV=0
# SHARK_RADIO_DEVICE=/dev/radio0
# SHARK_BITRATE=32
# SHARK_STREAM_BITRATE=64

# Host ids the containers run as. AUDIO_GID/VIDEO_GID are the groups owning
# /dev/snd/* and /dev/radio0 on the host (`stat -c %g /dev/radio0`); 29/44 on Debian.
# PUID=1000
# PGID=1000
# AUDIO_GID=29
# VIDEO_GID=44
# ICECAST_PORT=8770
